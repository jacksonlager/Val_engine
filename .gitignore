__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
node_modules/
frontend/node_modules/
frontend/dist/
.DS_Store
# Decision records are the audit trail and are versioned on purpose: data/overrides.yaml,
# data/precedent.yaml, data/proposals/*.json and data/published/ stay in git so a booked
# number always travels with the decision behind it. Only the superseded publish copies and
# the emitted next-quarter sidecar are local.
data/published/history/
data/open_items_carry.yaml

# slim companyfacts kept beside each EDGAR extract so a changed extraction re-derives offline
data/market_cache/*/edgar_raw/

# the gauntlet rewrites its report on every pytest run; the committed copy was removed from version control
training/report.json
training/report.md
# the synthetic chain's superseded publish copies, like data/published/history/
data/quarters/synthetic/ledger/published/history/

# variant workbooks are regenerated by scripts/make_variant_workbooks.py (tests write them to tmp)
training/variants/

# subagent worktrees and local Claude Code state
.claude/
